{
  "format": 1,
  "host": 1,
  "id": "banknote",
  "name": "Banknote Engraving",
  "version": "1.0.0",
  "category": "Print",
  "icon": "layers",
  "author": "Nexis",
  "description": "Engraved shading, looping guilloche, and a colour you choose to keep.",
  "params": [
    { "id": "ink", "label": "Main ink", "type": "color", "def": "#163a70", "uniform": "uInk", "group": "Ink and paper" },
    { "id": "paper", "label": "Paper colour", "type": "color", "def": "#efece4", "uniform": "uPaper", "group": "Ink and paper" },

    { "id": "preserve", "label": "Preserve selected hue", "type": "toggle", "def": true, "uniform": "uPreserve", "group": "Colour accent",
      "hint": "Off for a monochrome print" },
    { "id": "hue", "label": "Selected hue", "type": "range", "min": 0, "max": 360, "step": 1, "def": 25, "unit": "°", "uniform": "uHue", "group": "Colour accent",
      "hint": "Orange 25, red 0, green 105, blue 220", "when": [{ "param": "preserve", "eq": true }], "swatch": "hue" },
    { "id": "hueTol", "label": "Hue tolerance", "type": "range", "min": 0, "max": 90, "step": 1, "def": 36, "unit": "°", "uniform": "uTol", "group": "Colour accent",
      "when": [{ "param": "preserve", "eq": true }] },
    { "id": "hueFeather", "label": "Hue feather", "type": "range", "min": 0, "max": 60, "step": 1, "def": 12, "unit": "°", "uniform": "uFeather", "group": "Colour accent",
      "when": [{ "param": "preserve", "eq": true }] },
    { "id": "minSat", "label": "Minimum saturation", "type": "range", "min": 0, "max": 100, "step": 1, "def": 40, "uniform": "uMinSat", "map": "percent", "group": "Colour accent",
      "hint": "Keeps sand, rock and stone out of the accent", "when": [{ "param": "preserve", "eq": true }] },
    { "id": "accStr", "label": "Accent strength", "type": "range", "min": 0, "max": 100, "step": 1, "def": 80, "uniform": "uAccStr", "map": "percent", "group": "Colour accent",
      "when": [{ "param": "preserve", "eq": true }] },
    { "id": "keepSh", "label": "Keep shadows", "type": "range", "min": 0, "max": 100, "step": 1, "def": 65, "uniform": "uKeepSh", "map": "percent", "group": "Colour accent",
      "hint": "How much of the deepest shadow stays in the main ink", "when": [{ "param": "preserve", "eq": true }] },
    { "id": "accMode", "label": "Accent colour", "type": "select", "def": 0, "options": ["Original hue · printed ink", "Original colour", "Custom accent"],
      "uniform": "uAccMode", "group": "Colour accent", "when": [{ "param": "preserve", "eq": true }] },
    { "id": "accent", "label": "Custom accent", "type": "color", "def": "#b24f1f", "uniform": "uAccent", "group": "Colour accent",
      "when": [{ "param": "preserve", "eq": true }, { "param": "accMode", "eq": 2 }] },
    { "id": "previewMask", "label": "Preview hue mask", "type": "toggle", "def": false, "uniform": "uPreviewMask", "group": "Colour accent",
      "hint": "Shows the kept area in white", "when": [{ "param": "preserve", "eq": true }] },

    { "id": "spacing", "label": "Engraving spacing", "type": "range", "min": 1.5, "max": 14, "step": 0.1, "def": 3.4, "uniform": "uSpacing", "group": "Engraving",
      "hint": "Line pitch in thousandths of the short side" },
    { "id": "weight", "label": "Line weight", "type": "range", "min": 20, "max": 160, "step": 1, "def": 94, "uniform": "uWeight", "map": "percent", "group": "Engraving" },
    { "id": "angle", "label": "Engraving angle", "type": "range", "min": -90, "max": 90, "step": 1, "def": 0, "unit": "°", "uniform": "uAngle", "map": "degrees", "group": "Engraving" },
    { "id": "flow", "label": "Contour flow", "type": "range", "min": 0, "max": 100, "step": 1, "def": 65, "uniform": "uFlow", "map": "percent", "group": "Engraving",
      "hint": "How far lines bend and turn with the forms" },
    { "id": "cross", "label": "Cross-hatch", "type": "range", "min": 0, "max": 100, "step": 1, "def": 65, "uniform": "uCross", "map": "percent", "group": "Engraving",
      "hint": "A second family crossing the first, from the midtones down" },
    { "id": "open", "label": "Open highlights", "type": "range", "min": 0, "max": 100, "step": 1, "def": 80, "uniform": "uOpen", "map": "percent", "group": "Engraving",
      "hint": "Wider spacing and broken lines in the light tones" },
    { "id": "water", "label": "Water lines", "type": "range", "min": 0, "max": 100, "step": 1, "def": 100, "uniform": "uWater", "map": "percent", "group": "Engraving",
      "hint": "Level, rippling lines on smooth water" },
    { "id": "facade", "label": "Facade hairlines", "type": "range", "min": 0, "max": 100, "step": 1, "def": 100, "uniform": "uFacade", "map": "percent", "group": "Engraving",
      "hint": "Fine upright lines on walls, columns and statues" },
    { "id": "foliage", "label": "Foliage stipple", "type": "range", "min": 0, "max": 100, "step": 1, "def": 100, "uniform": "uFoliage", "map": "percent", "group": "Engraving",
      "hint": "Dots instead of lines on trees and leaves" },
    { "id": "contour", "label": "Contour strength", "type": "range", "min": 0, "max": 100, "step": 1, "def": 70, "uniform": "uContour", "map": "percent", "group": "Engraving",
      "hint": "One continuous line along the edges of shapes and silhouettes" },
    { "id": "edge", "label": "Outlines", "type": "range", "min": 0, "max": 100, "step": 1, "def": 70, "uniform": "uEdge", "map": "percent", "group": "Engraving",
      "hint": "Draws windows, rooflines and fine dark edges as solid lines" },
    { "id": "edgeDetail", "label": "Outline detail", "type": "range", "min": 0, "max": 100, "step": 1, "def": 50, "uniform": "uEdgeDetail", "map": "percent", "group": "Engraving",
      "when": [{ "param": "edge", "gt": 0 }] },

    { "id": "gStr", "label": "Guilloche strength", "type": "range", "min": 0, "max": 100, "step": 1, "def": 69, "uniform": "uGStr", "map": "percent", "group": "Guilloche" },
    { "id": "place", "label": "Guilloche placement", "type": "select", "def": 0, "options": ["Upper smooth regions", "Smooth regions", "Everywhere"],
      "uniform": "uPlace", "group": "Guilloche" },
    { "id": "upper", "label": "Upper region", "type": "range", "min": 5, "max": 100, "step": 1, "def": 55, "uniform": "uUpper", "map": "percent", "group": "Guilloche",
      "when": [{ "param": "place", "eq": 0 }] },
    { "id": "gScale", "label": "Guilloche scale", "type": "range", "min": 40, "max": 250, "step": 1, "def": 103, "uniform": "uGScale", "group": "Guilloche" },
    { "id": "gCurves", "label": "Guilloche curves", "type": "range", "min": 0, "max": 300, "step": 1, "def": 155, "uniform": "uGCurves", "group": "Guilloche" },

    { "id": "exposure", "label": "Exposure", "type": "range", "min": -1, "max": 1, "step": 0.05, "def": 0.1, "uniform": "uExposure", "group": "Tone and paper" },
    { "id": "contrast", "label": "Contrast", "type": "range", "min": 0.5, "max": 2.5, "step": 0.05, "def": 1.25, "uniform": "uContrast", "group": "Tone and paper" },
    { "id": "simplify", "label": "Simplify", "type": "range", "min": 0, "max": 100, "step": 1, "def": 60, "uniform": "uSimplify", "map": "percent", "group": "Tone and paper",
      "hint": "Evens out grain and busy reflections into clean masses, keeping edges" },
    { "id": "detail", "label": "Detail", "type": "range", "min": 0, "max": 200, "step": 1, "def": 90, "uniform": "uDetail", "map": "percent", "group": "Tone and paper",
      "hint": "Local contrast, so small things survive the line screen" },
    { "id": "wash", "label": "Ink wash", "type": "range", "min": 0, "max": 100, "step": 1, "def": 20, "uniform": "uWash", "map": "percent", "group": "Tone and paper",
      "hint": "A faint flat tint under the lines in the deepest shadows" },
    { "id": "tint", "label": "Paper tint", "type": "range", "min": 0, "max": 100, "step": 1, "def": 50, "uniform": "uTint", "map": "percent", "group": "Tone and paper",
      "hint": "Washes the paper with the photo's own colours" },
    { "id": "grain", "label": "Paper grain", "type": "range", "min": 0, "max": 100, "step": 1, "def": 35, "uniform": "uGrain", "map": "percent", "group": "Tone and paper" }
  ],
  "follow": { "angle": "angle", "offsets": [0, 60] },
  "facts": [{ "label": "Line pitch", "param": "spacing", "as": "px", "decimals": 1, "unit": "px" }],
  "presets": [
    { "name": "Monochrome", "description": "One ink, no accent", "settings": { "preserve": false } },
    { "name": "Teal note", "description": "Teal ink on cool paper, lighter outlines", "settings": {
      "ink": "#1d5559", "paper": "#e6ece3", "preserve": false, "edge": 40, "contour": 45, "cross": 50, "contrast": 1.05 } },
    { "name": "Fine line", "description": "Closer, finer lines for large prints", "settings": { "spacing": 2.4, "weight": 88 } },
    { "name": "Bold", "description": "Wider pitch and heavier lines", "settings": { "spacing": 5.5, "weight": 110, "edge": 85 } }
  ]
}
